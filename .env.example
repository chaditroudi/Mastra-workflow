# OpenAI / Anthropic — pick one. The supervisor uses structuredOutput-capable models.
OPENAI_API_KEY=sk-...
# Optional override for which model the agents use.
LLM_MODEL=gpt-4o-mini

# MongoDB. A replica set is REQUIRED for transactions. For local dev:
#   docker run -d --name mongo -p 27017:27017 mongo:7 --replSet rs0
#   docker exec -it mongo mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB_PREFIX=app

# Search backend. Leave blank to use the built-in stub search.
SEARCH_API_URL=
SEARCH_API_KEY=

# Email provider. Leave blank to use the stub backend (logs and returns success).
# Set to e.g. https://api.resend.com/emails (with the matching key) for real sends.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_KEY=

# HTTP API
PORT=3000
LOG_LEVEL=info

# Multi-tenancy strategy: "shared" (one DB, tenantID filter) or "isolated" (DB per tenant).
TENANCY_STRATEGY=shared
